# PantryCook v0.1
# Copy to .env and adjust. Docker Compose reads this file for variable substitution.

# SQLite file inside the api container (mounted on the pantrycook-data volume).
DATABASE_URL=sqlite:////data/pantrycook.db

# Optional Postgres instead of SQLite (uncomment the db service notes in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://pantrycook:pantrycook@db:5432/pantrycook

# Optional cook tips. Leave the key empty to run fully offline.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Comma-separated browser origins, or * for a private homelab.
CORS_ORIGINS=*
